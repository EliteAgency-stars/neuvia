# ——— Public ———
# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://neuvia.co

# ——— Database (Supabase) — server only, never expose ———
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Service-role key. Required to store form submissions and for /admin.
SUPABASE_SERVICE_ROLE_KEY=
# Random string used to hash IP addresses stored with submissions
IP_HASH_SALT=

# ——— Email notifications (optional, Resend) ———
RESEND_API_KEY=
# Inbox that receives new requests (suggested: founder@proyectumia.com)
CONTACT_RECIPIENT_EMAIL=
# Verified sender, e.g. "NEUVIA <noreply@neuvia.co>"
EMAIL_FROM=

# ——— Admin panel (/admin) — disabled unless both are set ———
# Strong password (min. 16 chars)
ADMIN_PASSWORD=
# Random secret (min. 32 chars) used to sign the admin session cookie
ADMIN_SESSION_SECRET=

# ——— Crawler policy ———
# allow | disallow  (training-data crawlers only; search & user-triggered retrieval stay allowed)
AI_TRAINING_CRAWLERS=allow
