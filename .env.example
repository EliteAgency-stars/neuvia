# ——— Public ———
NEXT_PUBLIC_SITE_URL=https://neuvia.co

# ——— Supabase (public values; defaults are built in) ———
# SUPABASE_URL=https://opagblruzwsrxsggkjsa.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ——— n8n pipeline (server only) ———
# Webhook of the "NEUVIA · Early Access" workflow (default shown)
# N8N_WEBHOOK_URL=https://n8n.santiagoorj.beer/webhook/neuvia-early-access
# Shared secret checked by the workflow (header X-Neuvia-Secret). Required.
N8N_WEBHOOK_SECRET=

# Random string used to hash IP addresses sent with submissions
IP_HASH_SALT=

# ——— Admin (/admin) ———
# Comma-separated emails allowed to sign in with Supabase Auth.
# Must also exist in public.neuvia_admins (RLS). Default: founder@proyectumia.com
# ADMIN_EMAILS=founder@proyectumia.com

# ——— Crawler policy ———
AI_TRAINING_CRAWLERS=allow
